struct PseudoWitnessSet{
    S<:AbstractSystem,
    R<:Union{Vector{ComplexF64},PathResult},
}
    F::S
    L::ProductSubspace
    # only non-singular results or solutions
    R::Vector{R}
    projective::Bool
    # is_irreducible is being set by decompose
    is_irreducible::Union{Nothing,Bool}
end


function PseudoWitnessSet(
    F::AbstractSystem,
    L::ProductSubspace,
    R,
    P::AbstractMatrix{<:Number};
    projective::Bool = is_linear(L) && is_homogeneous(System(F)),
    is_irreducible::Union{Nothing,Bool} = nothing,
)
    WitnessSet(F, L, R, P, projective, is_irreducible)
end


function PseudoWitnessSet(
    F::AbstractSystem,
    L::ProductSubspace,
    R,
    projection_coordinates::Vector{<:Int};
    projective::Bool = is_linear(L) && is_homogeneous(System(F)),
    is_irreducible::Union{Nothing,Bool} = nothing,
    )
    P = [i in projection_coordinates ? i == j : 0 for i in 1:]
    WitnessSet(F, L, R, P, projective, is_irreducible)
end

